{
  "name": "@tessera-verify/verify",
  "version": "0.1.1",
  "description": "Independent verifier for Tessera v1 and v2 action records",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tessera-verify": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint not configured'",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.5.0",
    "@tessera-verify/receipt-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexagor/tessera.git",
    "directory": "packages/verifier"
  },
  "homepage": "https://github.com/lexagor/tessera#readme",
  "bugs": {
    "url": "https://github.com/lexagor/tessera/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "keywords": [
    "tessera",
    "agent",
    "audit",
    "verifier",
    "verifiable-credentials",
    "eip-712"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
