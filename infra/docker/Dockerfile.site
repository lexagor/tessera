# syntax=docker/dockerfile:1
FROM node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS build
RUN corepack enable
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/site/package.json apps/site/
RUN pnpm install --filter @tessera/site... --frozen-lockfile=true
COPY apps/site ./apps/site
COPY docs ./docs
RUN pnpm --filter @tessera/site build

FROM caddy:2-alpine@sha256:78bd35025c7ba85961dd149ae670315129954e77abe2383ac47c89106b35ade9
COPY --from=build /app/apps/site/dist /srv
RUN printf ':8080 {\n\troot * /srv\n\ttry_files {path} {path}.html {path}/index.html /404.html\n\tfile_server\n}\n' > /etc/caddy/Caddyfile
RUN addgroup -S caddy && adduser -S -D -H -G caddy caddy
RUN mkdir -p /config /data && chown -R caddy:caddy /config /data /srv
USER caddy
EXPOSE 8080
