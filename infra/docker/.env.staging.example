# Staging-only values. Copy to .env.staging and replace every value. Never commit secrets.
STAGING_DATABASE_URL=postgres://tessera_app:change-me-app@postgres:5432/tessera_staging
STAGING_POSTGRES_PASSWORD=change-me-admin
STAGING_POSTGRES_APP_PASSWORD=change-me-app
STAGING_PUBLIC_BASE_URL=https://staging.thetessera.xyz
STAGING_VERIFY_BASE_URL=https://staging-verify.thetessera.xyz
STAGING_OIDC_ISSUER=https://your-staging-tenant.us.auth0.com/
STAGING_OIDC_CLIENT_ID=change-me
STAGING_OIDC_CLIENT_SECRET=change-me
STAGING_OIDC_REDIRECT_URI=https://staging.thetessera.xyz/auth/callback
STAGING_OIDC_LOGOUT_URL=https://your-staging-tenant.us.auth0.com/v2/logout
STAGING_OIDC_STATE_SECRET=replace-with-at-least-32-random-bytes
STAGING_BOOTSTRAP_EMAIL=staging-admin@thetessera.xyz
STAGING_OIDC_ALLOWED_DOMAINS=thetessera.xyz
STAGING_OIDC_ALLOWED_EMAILS=
STAGING_OIDC_UNVERIFIED_DEMO_EMAILS=
STAGING_BROKER_ADMIN_KEY=tsk_staging_replace_me
STAGING_BROKER_ADMIN_TOKEN=replace-with-random-token
STAGING_BROKER_SIGNING_KEY=0xreplace_with_a_staging_only_32_byte_hex_key
STAGING_TENANT_SECRET_ENC_KEY=0xreplace_with_a_staging_only_32_byte_hex_key
STAGING_CONTROL_PLANE_ENC_KEY=0xreplace_with_a_staging_only_32_byte_hex_key
STAGING_CONTROL_PLANE_RLS=0
STAGING_AUTHORITY_HMAC_SECRET=replace-with-at-least-32-random-bytes
STAGING_EMAIL_PROVIDER=disabled
STAGING_EMAIL_API_KEY=
STAGING_EMAIL_FROM=
STAGING_EVIDENCE_S3_BUCKET=
STAGING_EVIDENCE_S3_REGION=us-east-1
STAGING_EVIDENCE_S3_ENDPOINT=
STAGING_EVIDENCE_S3_ACCESS_KEY=
STAGING_EVIDENCE_S3_SECRET_KEY=
STAGING_EVIDENCE_S3_FORCE_PATH_STYLE=0
STAGING_CADDY_PORT=8082
TESSERA_API_IMAGE=ghcr.io/lexagor/tessera-api@sha256:replace
TESSERA_BROKER_IMAGE=ghcr.io/lexagor/tessera-broker@sha256:replace
TESSERA_PORTAL_IMAGE=ghcr.io/lexagor/tessera-portal@sha256:replace
TESSERA_VERIFY_IMAGE=ghcr.io/lexagor/tessera-verify@sha256:replace
TESSERA_SITE_IMAGE=ghcr.io/lexagor/tessera-site@sha256:replace
