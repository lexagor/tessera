{$SITE_DOMAIN} {
	encode gzip
	tls {$ACME_EMAIL}

	handle /app {
		redir https://{$APP_DOMAIN}/ 308
	}
	handle /app/* {
		uri strip_prefix /app
		redir https://{$APP_DOMAIN}{uri} 308
	}
	handle /login {
		redir https://{$APP_DOMAIN}/ 308
	}
	handle /verify {
		redir https://{$VERIFY_DOMAIN}/verify/ 308
	}
	handle /verify/* {
		redir https://{$VERIFY_DOMAIN}{uri} 308
	}
	handle {
		reverse_proxy site:80
	}
}

{$APP_DOMAIN} {
	encode gzip
	tls {$ACME_EMAIL}

	handle /v1/* {
		reverse_proxy api:8788
	}
	handle /auth/* {
		reverse_proxy api:8788
	}
	handle /openapi.json {
		reverse_proxy api:8788
	}
	handle /healthz {
		reverse_proxy api:8788
	}
	handle {
		reverse_proxy portal:80
	}
}

{$VERIFY_DOMAIN} {
	encode gzip
	tls {$ACME_EMAIL}

	handle /verify/* {
		reverse_proxy verify:80
	}
	handle {
		redir /verify/ 302
	}
}
