# Golden-path harness — environment

# ── Broker connection ───────────────────────────────────────────────────────
TESSERA_ENDPOINT=http://localhost:8787
TESSERA_API_KEY=tsk_demo_local
GOLDEN_AGENT_ID=golden-agent
GOLDEN_USER_ID=user_42

# ── Stripe (test mode) ──────────────────────────────────────────────────────
# Refund an existing test charge instead of creating one:
# STRIPE_CHARGE_ID=ch_3...
STRIPE_CHARGE_AMOUNT=500
STRIPE_CURRENCY=usd

# ── GitHub (optional; set GOLDEN_GITHUB=1 to enable) ────────────────────────
GOLDEN_GITHUB=0
GOLDEN_GITHUB_INSTALLATION_ID=
GOLDEN_GITHUB_API_BASE=https://api.github.com
