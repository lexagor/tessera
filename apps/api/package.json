{
  "name": "@tessera/api",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint not configured'",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "rm -rf dist",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@tessera-verify/receipt-schema": "workspace:*",
    "@tessera-verify/verify": "workspace:*",
    "@tessera/agent-receipts": "workspace:*",
    "@tessera/core-policy": "workspace:*",
    "hono": "^4.6.14",
    "openid-client": "^5.7.1",
    "postgres": "^3.4.5",
    "redis": "^4.7.0",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
