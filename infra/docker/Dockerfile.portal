# syntax=docker/dockerfile:1
FROM node:25-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4 AS build
RUN corepack enable
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/portal/package.json apps/portal/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --filter @tessera/portal... --frozen-lockfile=true
COPY tsconfig.base.json ./
COPY packages/ui ./packages/ui
COPY apps/portal ./apps/portal
RUN pnpm --filter @tessera/portal... build

FROM caddy:2-alpine@sha256:78bd35025c7ba85961dd149ae670315129954e77abe2383ac47c89106b35ade9
COPY --from=build /app/apps/portal/dist /srv
RUN printf ':8080 {\n\troot * /srv\n\ttry_files {path} /index.html\n\tfile_server\n}\n' > /etc/caddy/Caddyfile
RUN addgroup -S caddy && adduser -S -D -H -G caddy caddy
RUN mkdir -p /config /data && chown -R caddy:caddy /config /data /srv
USER caddy
EXPOSE 8080
