{
  "name": "@tessera-verify/mcp-adapter",
  "version": "0.1.2",
  "description": "MCP middleware that brokers Tessera credentials for each tool call",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint not configured'",
    "test": "node --test test/*.test.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tessera-verify/receipt-schema": "workspace:*",
    "@tessera-verify/sdk-ts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexagor/tessera.git",
    "directory": "packages/mcp-adapter"
  },
  "homepage": "https://thetessera.xyz",
  "bugs": {
    "url": "https://github.com/lexagor/tessera/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "keywords": [
    "tessera",
    "mcp",
    "model-context-protocol",
    "agents",
    "credentials",
    "audit"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
