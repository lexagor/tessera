{
  "name": "@tessera-verify/sdk-ts",
  "version": "0.1.3",
  "description": "Tessera agent SDK \u2014 wrap any tool client to broker ephemeral credentials",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint not configured'",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tessera-verify/receipt-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexagor/tessera.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://thetessera.xyz",
  "bugs": {
    "url": "https://github.com/lexagor/tessera/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "keywords": [
    "tessera",
    "agent",
    "sdk",
    "credentials",
    "audit",
    "tool-calling"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
