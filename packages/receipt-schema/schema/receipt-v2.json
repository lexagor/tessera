{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tessera:receipt:v2",
  "title": "Tessera Action Record v2",
  "type": "object",
  "required": [
    "v",
    "tenant",
    "agent",
    "user",
    "intentHash",
    "authorization",
    "call",
    "grant",
    "ts",
    "nonce",
    "actionId",
    "principal",
    "agentMeta",
    "intent",
    "policy",
    "attestation"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 2
    },
    "tenant": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "user": {
      "type": "string"
    },
    "intentHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "authorization": {
      "type": "object",
      "required": [
        "decision",
        "policy",
        "policyVersion",
        "resource",
        "anomalyScore"
      ],
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "policy": {
          "type": "string"
        },
        "policyVersion": {
          "type": "integer",
          "minimum": 0
        },
        "resource": {
          "type": "string"
        },
        "anomalyScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "policyHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "required": [
        "tool",
        "argsHash"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "argsHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "resultHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "toolHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "grant": {
      "type": "object",
      "required": [
        "provider",
        "ttlS",
        "singleUse",
        "status"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "ttlS": {
          "type": "integer",
          "minimum": 0
        },
        "singleUse": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "issued",
            "used",
            "denied",
            "expired",
            "revoked"
          ]
        }
      },
      "additionalProperties": false
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string"
    },
    "prev": {
      "type": [
        "string",
        "null"
      ]
    },
    "signature": {
      "type": [
        "string",
        "null"
      ]
    },
    "actionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "principal": {
      "type": "object",
      "required": [
        "principalId",
        "principalType",
        "authorityRef",
        "authorityHash",
        "verificationMethod"
      ],
      "properties": {
        "principalId": {
          "type": "string"
        },
        "principalType": {
          "type": "string"
        },
        "authorityRef": {
          "type": "string"
        },
        "authorityHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "verificationMethod": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "agentMeta": {
      "type": "object",
      "required": [
        "agentId"
      ],
      "properties": {
        "agentId": {
          "type": "string"
        },
        "agentVersion": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "operatorId": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "intent": {
      "type": "object",
      "required": [
        "intentHash"
      ],
      "properties": {
        "intentHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "requestedScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "riskClass": {
          "type": "string"
        },
        "declaredPurpose": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "policyId",
        "policyVersion",
        "policyHash",
        "decision"
      ],
      "properties": {
        "policyId": {
          "type": "string"
        },
        "policyVersion": {
          "type": "integer",
          "minimum": 0
        },
        "policyHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "decision": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "reasonCode": {
          "type": "string"
        },
        "evaluatedInputsHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "evaluatorVersion": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "credential": {
      "type": "object",
      "required": [
        "issuer",
        "credentialType",
        "thumbprint",
        "ttlSeconds",
        "singleUse",
        "issuanceId"
      ],
      "properties": {
        "issuer": {
          "type": "string"
        },
        "credentialType": {
          "type": "string"
        },
        "thumbprint": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "singleUse": {
          "type": "boolean"
        },
        "issuanceId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": [
        "status",
        "completedAt"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "resultHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "errorClass": {
          "type": "string"
        },
        "externalRef": {
          "type": "string"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "enum": [
            "broker_observed",
            "agent_reported"
          ]
        }
      },
      "additionalProperties": false
    },
    "attestation": {
      "type": "object",
      "required": [
        "signerKeyId",
        "signatureAlg"
      ],
      "properties": {
        "signerKeyId": {
          "type": "string"
        },
        "signatureAlg": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "transparencyLogIndex": {
          "type": "integer",
          "minimum": 0
        },
        "anchorRef": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authorizationReceiptId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    }
  }
}
